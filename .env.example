# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does. Empty or commented-out
# values use the default.

# --- Feeds -----------------------------------------------------------------

# JSON event feed.
# EVENTS_JSON_URL=https://events.pdxhackerspace/events.json

# Optional ICS calendar feed, read as well as the JSON feed.
# EVENTS_ICS_URL=https://events.example.org/events.ics

# How far back and ahead to expand ICS recurrences, in days.
# ICS_LOOKBACK_DAYS=30
# ICS_LOOKAHEAD_DAYS=365

# Seconds between ingestion cycles.
POLL_INTERVAL_SECONDS=3600

# Timeout for feed and embeddings API requests, in seconds.
# REQUEST_TIMEOUT_SECONDS=30

# --- Qdrant ----------------------------------------------------------------

# The compose files point this at their own Qdrant; set it when running
# without them.
# QDRANT_URL=http://localhost:6333

# Only if your Qdrant requires an API key.
# QDRANT_API_KEY=REPLACE_ME

# Collection to create and upsert into.
QDRANT_COLLECTION=events

# Cosine, Dot, Euclid or Manhattan; used when creating the collection.
# QDRANT_DISTANCE=Cosine

# --- Embeddings ------------------------------------------------------------

# openai, onnx (needs the onnx extra) or sentence-transformers (needs the
# torch extra). The Docker image has only openai.
EMBEDDING_BACKEND=openai

# Model the API serves, or Hugging Face repo for onnx/sentence-transformers.
# Changing it changes the vector size: use a new QDRANT_COLLECTION.
# The default is ModernBERT Embed from Hugging Face, served by a local
# OpenAI-compatible server (768 dimensions, up to 8192 tokens), e.g.
#   docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:cpu-latest --model-id nomic-ai/modernbert-embed-base
# Other options (set the prefixes below to match):
#   nomic-embed-text                 Ollama; same prefixes as ModernBERT
#   intfloat/e5-base-v2, e5-*        query: / passage:
#   mxbai-embed-large                query prefix only
#   Qwen/Qwen3-Embedding-0.6B        instruction query prefix only
#   text-embedding-3-small/-large    api.openai.com; no prefixes
EMBEDDING_MODEL_NAME=nomic-ai/modernbert-embed-base

# Texts per embedding request.
# EMBEDDING_BATCH_SIZE=64

# Token limit per text, prefix included; longer texts are truncated before
# embedding. Keep it at or below the server's max input length.
# EMBEDDING_CONTEXT_LENGTH=512

# Prompt prefixes the model was trained with: one on search queries, one on
# the documents (events) being searched. Retrieval is worse without the
# right ones. A space is added after each; write \n for a newline and none
# for no prefix (empty means the ModernBERT default). Changing the document
# prefix re-embeds every stored event on the next cycle. Anything that
# searches the collection must add the query prefix to its queries.
#
#   Model                          Query prefix                Document prefix
#   nomic-ai/modernbert-embed-*,   search_query:               search_document:
#     nomic-embed-text
#   e5 family                      query:                      passage:
#   mxbai-embed-large              Represent this sentence     none
#                                  for searching relevant
#                                  passages:
#   Qwen3-Embedding and similar    Instruct: Given a question, none
#                                  find matching events\nQuery:
#   OpenAI text-embedding-3-*      none                        none
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:

# OpenAI-compatible API base URL; defaults to a local server on port 8080.
# From inside Docker, a server on the Docker host is
# http://host.docker.internal:8080/v1 (Ollama: port 11434). For OpenAI,
# use https://api.openai.com/v1.
# OPENAI_BASE_URL=http://localhost:8080/v1

# API key, sent as a bearer token. Usually unneeded for a local server;
# required for api.openai.com.
# OPENAI_API_KEY=REPLACE_ME

# --- Logging ---------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Production compose (not read by the app) ------------------------------

# Image tag docker-compose.prod.yaml runs; defaults to latest.
# APP_VERSION=1.2.3

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME

EVENTS_JSON_URL=https://events.pdxhackerspace/events.json
# Optional ICS feed URL
EVENTS_ICS_URL=
POLL_INTERVAL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=30

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=events
QDRANT_DISTANCE=Cosine

# openai (default), onnx (requires pip install .[onnx]),
# or sentence-transformers (requires pip install .[torch])
EMBEDDING_BACKEND=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
# Max tokens to send per input (inputs are truncated client-side)
EMBEDDING_CONTEXT_LENGTH=512

# OpenAI-compatible API base URL (only used when EMBEDDING_BACKEND=openai).
# Point at any OpenAI-compatible server, e.g. http://ollama:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional API key, sent as a bearer token (required for api.openai.com)
OPENAI_API_KEY=

ICS_LOOKBACK_DAYS=30
ICS_LOOKAHEAD_DAYS=365
LOG_LEVEL=INFO

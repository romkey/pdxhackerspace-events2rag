# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does. Empty or commented-out
# values use the default.

# --- Feeds -----------------------------------------------------------------

# JSON event feed.
# EVENTS_JSON_URL=https://events.pdxhackerspace/events.json

# Optional ICS calendar feed, read as well as the JSON feed.
# EVENTS_ICS_URL=https://events.example.org/events.ics

# How far back and ahead to expand ICS recurrences, in days.
# ICS_LOOKBACK_DAYS=30
# ICS_LOOKAHEAD_DAYS=365

# Seconds between ingestion cycles.
POLL_INTERVAL_SECONDS=3600

# Timeout for feed and Ollama requests, in seconds.
# REQUEST_TIMEOUT_SECONDS=30

# --- Qdrant ----------------------------------------------------------------

# The compose files point this at their own Qdrant; set it when running
# without them.
# QDRANT_URL=http://localhost:6333

# Only if your Qdrant requires an API key.
# QDRANT_API_KEY=REPLACE_ME

# Collection to create and upsert into.
QDRANT_COLLECTION=events

# Cosine, Dot, Euclid or Manhattan; used when creating the collection.
# QDRANT_DISTANCE=Cosine

# --- Embeddings ------------------------------------------------------------

# ollama, onnx (needs the onnx extra) or sentence-transformers (needs the
# torch extra). The Docker image has only ollama.
EMBEDDING_BACKEND=ollama

# Ollama model name, or Hugging Face repo for onnx/sentence-transformers.
EMBEDDING_MODEL_NAME=qllama/bge-small-en-v1.5

# Texts per embedding request.
# EMBEDDING_BATCH_SIZE=64

# The model's token limit (512 for bge-small-en-v1.5); longer texts are
# truncated.
# EMBEDDING_CONTEXT_LENGTH=512

# Ollama endpoint. For Ollama on the Docker host, use
# http://host.docker.internal:11434.
OLLAMA_URL=http://ollama:11434

# Only for hosted or proxied Ollama-compatible APIs that need a bearer token.
# OLLAMA_API_KEY=REPLACE_ME

# --- Logging ---------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Production compose (not read by the app) ------------------------------

# Image tag docker-compose.prod.yaml runs; defaults to latest.
# APP_VERSION=1.2.3

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME

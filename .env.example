EVENTS_JSON_URL=https://events.pdxhackerspace/events.json
# Optional ICS feed URL
EVENTS_ICS_URL=
POLL_INTERVAL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=30

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=events
QDRANT_DISTANCE=Cosine

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# openai (default): any OpenAI-compatible /v1/embeddings server, local or
#   hosted. onnx (requires pip install .[onnx]) and sentence-transformers
#   (requires pip install .[torch]) run the model in-process instead.
EMBEDDING_BACKEND=openai

# Default: ModernBERT Embed from Hugging Face, served by a local
# OpenAI-compatible provider (768 dims, up to 8192 tokens). Examples:
#   text-embeddings-inference:
#     docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:cpu-latest \
#       --model-id nomic-ai/modernbert-embed-base
#   vLLM:
#     vllm serve nomic-ai/modernbert-embed-base --task embed --port 8080
EMBEDDING_MODEL_NAME=nomic-ai/modernbert-embed-base
EMBEDDING_BATCH_SIZE=64
# Max tokens to send per input. Inputs are truncated client-side, and the
# prefix below counts toward this budget. Keep it at or below the server's
# max input length.
EMBEDDING_CONTEXT_LENGTH=512

# Prompt prefixes. Many embedding models are trained to see a task prefix
# on queries and/or documents, and retrieve noticeably worse without it.
# The ingester embeds events with EMBEDDING_DOCUMENT_PREFIX. Anything that
# searches the collection must embed its query with EMBEDDING_QUERY_PREFIX.
#
#   Model                         Query prefix                 Document prefix
#   ----------------------------  ---------------------------  ----------------
#   nomic-ai/modernbert-embed-*   search_query:                search_document:
#   nomic-embed-text              search_query:                search_document:
#   e5 family (intfloat/e5-*)     query:                       passage:
#   mxbai-embed-large             Represent this sentence for  (none)
#                                 searching relevant passages:
#   Qwen3-Embedding and similar   an instruction line, e.g.    (none)
#                                 Instruct: Given a question,
#                                 retrieve matching events\nQuery:
#   OpenAI text-embedding-3-*     (none)                       (none)
#   bge-*-en-v1.5                 (none, or the bge query      (none)
#                                 instruction)
#
# A space is added after a prefix automatically, so don't add a trailing
# one. Write \n for a newline. Leave a variable empty (VAR=) for no prefix.
# If a variable is unset, the ModernBERT prefixes are used.
#
# Changing the model or the document prefix re-embeds every stored
# occurrence on the next cycle. A query prefix change needs no reingest.
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:

# OpenAI-compatible API base URL (only used when EMBEDDING_BACKEND=openai).
# Local provider (default): http://localhost:8080/v1, or e.g.
# http://host.docker.internal:8080/v1 from inside Docker.
# Ollama: http://ollama:11434/v1   OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:8080/v1
# Optional API key, sent as a bearer token. Usually unneeded for a local
# provider. Required for api.openai.com.
OPENAI_API_KEY=

ICS_LOOKBACK_DAYS=30
ICS_LOOKAHEAD_DAYS=365
LOG_LEVEL=INFO
